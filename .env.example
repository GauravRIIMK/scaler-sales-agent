# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic — Haiku 4.5 / Sonnet 4.6 / Opus 4.7
ANTHROPIC_API_KEY=

# Voyage AI — voyage-3-large embedder + voyage-rerank-2.5 reranker
VOYAGE_API_KEY=

# Twilio WhatsApp — Business number OR Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=        # e.g. whatsapp:+14155238886 (sandbox) or whatsapp:+<your-business#>

# Supabase — Postgres + pgvector + Storage + auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PDFS=scaler-sales-pdfs
SUPABASE_BUCKET_AUDIO=scaler-sales-audio

# Deepgram — Nova-3 STT with diarisation
DEEPGRAM_API_KEY=

# Optional fallbacks
OPENAI_API_KEY=              # embedder fallback only
GROQ_API_KEY=                # STT fallback only (Whisper-large-v3)

# App runtime
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Twilio status callback (defaults to {PUBLIC_APP_URL}/api/twilio/status).
# Override if you use ngrok or a different public URL.
# TWILIO_STATUS_CALLBACK_URL=https://your-tunnel/api/twilio/status

# Skip Twilio signature validation (dev only — NEVER set in prod).
# TWILIO_SKIP_VALIDATION=true

# Default BDA WhatsApp recipient for the nudge send route.
# BDA_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# BDA approval gate — shared secret checked by /decision, /pdf, and /deliver.
# Evaluators paste this into the Approval Panel UI.
BDA_APPROVAL_CODE=                       # e.g. SCALER-APPROVE-9421
